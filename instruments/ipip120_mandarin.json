  "user_readable_name": "IPIP-NEO-120 (Mandarin)",
  "items": {
    "ipip120m_1": "为很多事情感到担心",
    "ipip120m_2": "很容易交到朋友",
    "ipip120m_3": "有丰富的想象力",
    "ipip120m_4": "信任其他人",
    "ipip120m_5": "能成功完成任务",
    "ipip120m_6": "很容易生气",
    "ipip120m_7": "喜欢参加大型聚会",
    "ipip120m_8": "认为艺术是很重要的",
    "ipip120m_9": "会利用他人来达成自己的目的",
    "ipip120m_10": "喜欢整洁",
    "ipip120m_11": "时常感到忧郁",
    "ipip120m_12": "承担责任",
    "ipip120m_13": "能强烈感受到自己的情绪",
    "ipip120m_14": "乐于帮助他人",
    "ipip120m_15": "信守承诺",
    "ipip120m_16": "感觉自己很难接近别人",
    "ipip120m_17": "总是很忙碌",
    "ipip120m_18": "相比墨守成规，我更喜欢有变化。",
    "ipip120m_19": "喜欢和别人比试",
    "ipip120m_20": "工作努力",
    "ipip120m_21": "大吃大喝寻欢作乐",
    "ipip120m_22": "喜欢追求刺激",
    "ipip120m_23": "喜欢阅读有挑战性的材料",
    "ipip120m_24": "相信自己比别人更好",
    "ipip120m_25": "我总是有所准备",
    "ipip120m_26": "容易慌张",
    "ipip120m_27": "我的快乐会感染周围的人",
    "ipip120m_28": "认为自己在政治方面非常自由开放",
    "ipip120m_29": "同情流浪汉",
    "ipip120m_30": "会不经过思考就开始行动",
    "ipip120m_31": "担心会发生最糟糕的情况",
    "ipip120m_32": "和其他人待在一起时，我觉得很自在",
    "ipip120m_33": "喜欢天马行空地幻想",
    "ipip120m_34": "相信他人的出发点是好的",
    "ipip120m_35": "在自己所从事的领域出类拔萃",
    "ipip120m_36": "容易被激怒",
    "ipip120m_37": "在聚会上，我会和很多不同的人交谈",
    "ipip120m_38": "我能发现别人看不到的美",
    "ipip120m_39": "为了领先别人，我会采用作弊的方式",
    "ipip120m_40": "经常忘记把东西放回原处",
    "ipip120m_41": "不喜欢自己",
    "ipip120m_42": "我会尝试去领导他人",
    "ipip120m_43": "能感受到他人的情绪",
    "ipip120m_44": "关心他人",
    "ipip120m_45": "我会实话实说",
    "ipip120m_46": "害怕引起他人的注意",
    "ipip120m_47": "总是在奔波",
    "ipip120m_48": "我更喜欢做自己熟悉的事情",
    "ipip120m_49": "会冲人大喊大叫",
    "ipip120m_50": "我会超出预期地完成任务或工作",
    "ipip120m_51": "很少过度放纵自己",
    "ipip120m_52": "喜欢冒险",
    "ipip120m_53": "会避免参与关于哲学的讨论",
    "ipip120m_54": "觉得自己很了不起",
    "ipip120m_55": "能执行自己制定的计划",
    "ipip120m_56": "感到被各种事情压得喘不过气来",
    "ipip120m_57": "我的生活很快乐",
    "ipip120m_58": "相信没有绝对的对错之分",
    "ipip120m_59": "我同情那些处境不如自己的人",
    "ipip120m_60": "会做出草率的决定",
    "ipip120m_61": "对很多事情感到害怕",
    "ipip120m_62": "避免和他人接触",
    "ipip120m_63": "喜欢做白日梦",
    "ipip120m_64": "相信他人说的话",
    "ipip120m_65": "能轻松完成任务",
    "ipip120m_66": "发脾气",
    "ipip120m_67": "更喜欢一个人独处",
    "ipip120m_68": "不喜欢诗歌",
    "ipip120m_69": "占别人的便宜",
    "ipip120m_70": "我的房间很乱",
    "ipip120m_71": "经常情绪低落",
    "ipip120m_72": "掌控局面",
    "ipip120m_73": "很少察觉到自己的情绪反应",
    "ipip120m_74": "对他人的感受漠不关心",
    "ipip120m_75": "破坏规则",
    "ipip120m_76": "只有和朋友在一起的时候我才会感到自在",
    "ipip120m_77": "我的闲暇时间非常充实",
    "ipip120m_78": "不喜欢改变",
    "ipip120m_79": "侮辱他人",
    "ipip120m_80": "在工作或学习上，我不会多做，过得去就行",
    "ipip120m_81": "能轻松抵御诱惑",
    "ipip120m_82": "喜欢不计后果地行事",
    "ipip120m_83": "理解抽象概念对我来说有些困难",
    "ipip120m_84": "对自己的评价很高",
    "ipip120m_85": "浪费时间",
    "ipip120m_86": "感觉自己处理事情力不从心",
    "ipip120m_87": "热爱生活",
    "ipip120m_88": "我在政治上比较保守",
    "ipip120m_89": "对别人遇到的麻烦事不感兴趣",
    "ipip120m_90": "仓促行事",
    "ipip120m_91": "我很容易觉得压力大",
    "ipip120m_92": "和他人保持距离",
    "ipip120m_93": "喜欢陷入沉思",
    "ipip120m_94": "不相信别人",
    "ipip120m_95": "知道如何完成任务",
    "ipip120m_96": "不会轻易被惹恼",
    "ipip120m_97": "避开人多的地方",
    "ipip120m_98": "不喜欢去美术馆",
    "ipip120m_99": "给别人使坏",
    "ipip120m_100": "我的东西放得到处都是",
    "ipip120m_101": "对自己感到满意",
    "ipip120m_102": "等着别人来带头",
    "ipip120m_103": "不理解那些情绪化的人",
    "ipip120m_104": "不愿为他人花费时间",
    "ipip120m_105": "违背自己的承诺",
    "ipip120m_106": "不会被复杂的社交情境所困扰",
    "ipip120m_107": "喜欢慢慢来",
    "ipip120m_108": "我喜欢传统的方式",
    "ipip120m_109": "报复别人",
    "ipip120m_110": "对工作或学业不怎么投入时间和精力",
    "ipip120m_111": "可以控制自己的欲望",
    "ipip120m_112": "我的行为狂放不羁",
    "ipip120m_113": "对理论性的讨论不感兴趣",
    "ipip120m_114": "吹嘘自己的美德",
    "ipip120m_115": "拖很久才开始做一件事",
    "ipip120m_116": "在压力下能保持冷静",
    "ipip120m_117": "看到生活中好的一面",
    "ipip120m_118": "认为我们应该严惩犯罪",
    "ipip120m_119": "我尽量不去想那些需要帮助的人",
    "ipip120m_120": "做事不经过思考"
